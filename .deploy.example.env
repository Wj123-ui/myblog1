# 部署目标与凭据模板 —— 复制为 .deploy.env 后填写真实值。
# .deploy.env 已被 .gitignore 忽略，请勿把填好的文件提交到仓库。
# 也可以用同名环境变量覆盖这里的值。

# 服务器地址（必需）
DEPLOY_HOST=your.server.ip

# SSH 端口与用户名
DEPLOY_PORT=22
DEPLOY_USER=root

# SSH 密码；如已配置 SSH 密钥登录可留空
DEPLOY_PASSWORD=

# 站点根地址，用于生成 canonical / og:url / sitemap。纯 IP 访问填 http://<ip>
DEPLOY_SITE_URL=http://your.server.ip

# 远端站点目录与文件属主
DEPLOY_REMOTE_DIR=/var/www/myblog1
DEPLOY_WEB_USER=www-data
